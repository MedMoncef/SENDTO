<Window x:Class="DropRoom.PinDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Enter PIN" Width="360" Height="210" WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize" Background="#F5F7FB">
    <StackPanel Margin="24">
        <TextBlock Text="Enter transfer PIN" FontSize="20" FontWeight="SemiBold"/>
        <TextBlock x:Name="Description" Margin="0,6,0,14" Foreground="#667085"/>
        <PasswordBox x:Name="PinBox" Padding="10,8" MaxLength="6"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button Content="Cancel" Padding="14,8" Margin="0,0,8,0" Click="Cancel_Click"/>
            <Button Content="Unlock" Padding="14,8" Background="#635BFF" Foreground="White" Click="Unlock_Click"/>
        </StackPanel>
    </StackPanel>
</Window>
