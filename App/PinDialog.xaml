<Window x:Class="DropRoom.PinDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Enter PIN" Width="420" Height="290" MinHeight="250" WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize" Background="#F5F7FB">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <StackPanel Orientation="Horizontal">
            <Border Width="38" Height="38" CornerRadius="12" Background="#090B14" Margin="0,0,10,0"
                    Padding="2">
                <Border CornerRadius="9" Background="#635BFF">
                    <TextBlock Text="D" Foreground="White" FontSize="20" FontWeight="Bold"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               TextAlignment="Center"/>
                </Border>
            </Border>
            <TextBlock Text="Enter transfer PIN" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center"/>
        </StackPanel>
        <TextBlock Grid.Row="1" x:Name="Description" Margin="0,6,0,14" Foreground="#667085"/>
        <Grid Grid.Row="2">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <PasswordBox x:Name="PinBox" Padding="10,8" MaxLength="6"/>
            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
                <Button Content="Cancel" Padding="14,8" Margin="0,0,8,0" Click="Cancel_Click"/>
                <Button Content="Unlock" Padding="14,8" Background="#635BFF" Foreground="White" Click="Unlock_Click"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
