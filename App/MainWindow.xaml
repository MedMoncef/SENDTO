<Window x:Class="DropRoom.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DropRoom" Icon="{DynamicResource DropRoomLogo}" Height="720" Width="1120" MinHeight="600" MinWidth="900"
        WindowStartupLocation="CenterScreen" Background="#EEF1FF">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#F5F7FF" Offset="0"/>
                <GradientStop Color="#E9E7FF" Offset="0.48"/>
                <GradientStop Color="#F9F4FF" Offset="1"/>
            </LinearGradientBrush>
        </Grid.Background>
        <Ellipse Width="420" Height="420" Fill="#665F5BFF" HorizontalAlignment="Right"
                 VerticalAlignment="Top" Margin="0,-170,-120,0" IsHitTestVisible="False">
            <Ellipse.Effect><BlurEffect Radius="70"/></Ellipse.Effect>
        </Ellipse>
        <Ellipse Width="330" Height="330" Fill="#5536C5FF" HorizontalAlignment="Left"
                 VerticalAlignment="Bottom" Margin="-140,0,0,-120" IsHitTestVisible="False">
            <Ellipse.Effect><BlurEffect Radius="80"/></Ellipse.Effect>
        </Ellipse>
        <Border Grid.Column="0" Background="#E8171B2D" BorderBrush="#2CFFFFFF" BorderThickness="0,0,1,0">
            <Grid Margin="24">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Image Width="44" Height="44" Margin="0,0,11,0"
                               Source="{DynamicResource DropRoomLogo}"/>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="DropRoom" Foreground="White" FontSize="23" FontWeight="SemiBold"/>
                            <TextBlock Text="Private file sharing" Foreground="#AAB1C5" Margin="0,2,0,0"/>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
                <StackPanel Grid.Row="1" Margin="0,48,0,0">
                    <Border Background="#35FFFFFF" BorderBrush="#28FFFFFF" BorderThickness="1"
                            CornerRadius="14" Padding="14" Margin="0,0,0,10"
                            Effect="{StaticResource SmallShadow}">
                        <StackPanel>
                            <TextBlock Text="ROOM" FontSize="11" Foreground="#9EA7C2" FontWeight="SemiBold"/>
                            <TextBlock x:Name="RoomStatusText" Text="Connecting…" Foreground="White" Margin="0,6,0,0"
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                    <TextBlock Text="Everything is encrypted before sharing." Foreground="#AAB1C5"
                               TextWrapping="Wrap" Margin="4,10,8,0"/>
                </StackPanel>
                <Button Grid.Row="2" Content="⚙  Settings" HorizontalContentAlignment="Left"
                        Background="Transparent" Foreground="#D7DBEA" Click="Settings_Click"/>
            </Grid>
        </Border>
        <Grid Grid.Column="1" Margin="34">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <Grid Grid.Row="0" Margin="0,0,0,28">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Your room" FontSize="30" FontWeight="SemiBold" Foreground="{StaticResource Ink}"/>
                    <TextBlock Text="Send a file in seconds, or pick one up where you need it."
                               Foreground="{StaticResource Muted}" Margin="0,5,0,0" FontSize="14"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"
                            HorizontalAlignment="Right">
                    <Button Content="Receive here" Background="#CFFFFFFF" Foreground="{StaticResource Ink}"
                            BorderBrush="#AFFFFFFF" BorderThickness="1" Click="Receive_Click"
                            Effect="{StaticResource SmallShadow}"/>
                    <Button Content="Send a file" Background="#635BFF" Foreground="White" Margin="10,0,0,0"
                            Effect="{StaticResource SmallShadow}"
                            Click="Send_Click"/>
                </StackPanel>
            </Grid>
            <Border Grid.Row="1" Background="#AFFFFFFF" BorderBrush="#B8FFFFFF" BorderThickness="1"
                    CornerRadius="16" Padding="16" Margin="0,0,0,20"
                    Effect="{StaticResource SmallShadow}">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse Width="9" Height="9" Fill="#635BFF" Margin="0,0,12,0"
                             VerticalAlignment="Center"/>
                    <TextBlock x:Name="ModeText" Text="Local network (LAN)" Foreground="#423B9A"
                               FontWeight="SemiBold" VerticalAlignment="Center"/>
                    <TextBlock x:Name="ModeDescription" Text="  Files stay on your local network and expire automatically."
                               Foreground="#5A55A8" VerticalAlignment="Center"/>
                </StackPanel>
            </Border>
            <Border Grid.Row="2" Background="#DFFFFFFF" CornerRadius="20" BorderBrush="#B8FFFFFF" BorderThickness="1"
                    Padding="22" Effect="{StaticResource CardShadow}">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <DockPanel>
                        <StackPanel>
                            <TextBlock Text="Available files" FontSize="20" FontWeight="SemiBold" Foreground="{StaticResource Ink}"/>
                            <TextBlock Text="Files shared with your room appear here." Foreground="{StaticResource Muted}" Margin="0,4,0,0"/>
                        </StackPanel>
                        <Border DockPanel.Dock="Right" Width="240" Height="40" CornerRadius="12"
                            Background="#BFFFFFFF" BorderBrush="#B8FFFFFF" BorderThickness="1">
                        <Grid>
                            <TextBlock Text="⌕" FontSize="20" Foreground="{StaticResource Muted}"
                                       VerticalAlignment="Center" Margin="12,0,0,0"/>
                            <TextBox x:Name="SearchBox" Margin="34,0,4,0" VerticalContentAlignment="Center"
                                     Background="Transparent" BorderThickness="0"
                                     ToolTip="Search files" TextChanged="SearchBox_TextChanged"/>
                        </Grid>
                        </Border>
                    </DockPanel>
                    <TextBlock Grid.Row="1" x:Name="EmptyStateText"
                               Text="No files yet. Send one to get started."
                               Foreground="{StaticResource Muted}" Margin="0,22,0,12"/>
                    <ListView Grid.Row="2" x:Name="TransfersList" BorderThickness="0"
                              SelectionChanged="TransfersList_SelectionChanged" Background="Transparent">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#8FFFFFFF" BorderBrush="#70FFFFFF" BorderThickness="1"
                                        CornerRadius="14" Padding="14" Margin="0,0,0,8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="2.2*"/>
                                            <ColumnDefinition Width="1.2*"/>
                                            <ColumnDefinition Width="0.7*"/>
                                            <ColumnDefinition Width="1.1*"/>
                                            <ColumnDefinition Width="0.85*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Margin="0,0,14,0">
                                            <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" Foreground="{StaticResource Ink}" FontSize="14"/>
                                            <TextBlock Text="{Binding Note}" Foreground="{StaticResource Muted}" Margin="0,4,0,0"
                                                       TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                        <TextBlock Grid.Column="1" Text="{Binding SenderName}" Foreground="{StaticResource Muted}"
                                                   TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                        <TextBlock Grid.Column="2" Text="{Binding SizeText}" Foreground="{StaticResource Muted}"
                                                   VerticalAlignment="Center" Margin="0,0,10,0"/>
                                        <TextBlock Grid.Column="3" Text="{Binding ExpiresText}" Foreground="{StaticResource Muted}"
                                                   TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                        <TextBlock Grid.Column="4" Text="{Binding Status}" Foreground="#635BFF"
                                                   VerticalAlignment="Center" Margin="0,0,10,0"/>
                                        <Button Grid.Column="5" Content="Remove" Tag="{Binding}" Padding="10,7" Margin="0"
                                                Background="#FFF1F3" Foreground="#B42318"
                                                Click="DeleteTransfer_Click"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
