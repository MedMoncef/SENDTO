<Application x:Class="DropRoom.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:DropRoom">
    <Application.Resources>
        <DrawingImage x:Key="DropRoomLogo">
            <DrawingImage.Drawing>
                <DrawingGroup>
                    <GeometryDrawing Brush="#080A12">
                        <GeometryDrawing.Geometry>
                            <RectangleGeometry Rect="0,0,100,100" RadiusX="25" RadiusY="25"/>
                        </GeometryDrawing.Geometry>
                    </GeometryDrawing>
                    <GeometryDrawing>
                        <GeometryDrawing.Brush>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#7468FF" Offset="0"/>
                                <GradientStop Color="#4A35D6" Offset="0.58"/>
                                <GradientStop Color="#16C7D9" Offset="1"/>
                            </LinearGradientBrush>
                        </GeometryDrawing.Brush>
                        <GeometryDrawing.Geometry>
                            <RectangleGeometry Rect="7,7,86,86" RadiusX="20" RadiusY="20"/>
                        </GeometryDrawing.Geometry>
                    </GeometryDrawing>
                    <GeometryDrawing Brush="#FFFFFFFF">
                        <GeometryDrawing.Geometry>
                            <PathGeometry Figures="M31,24 L49,24 C67,24 77,34 77,50 C77,66 67,76 49,76 L31,76 Z M43,35 L43,65 L49,65 C58,65 64,60 64,50 C64,40 58,35 49,35 Z"/>
                        </GeometryDrawing.Geometry>
                    </GeometryDrawing>
                    <GeometryDrawing Brush="#48FFFFFF">
                        <GeometryDrawing.Geometry>
                            <EllipseGeometry Center="75,20" RadiusX="5" RadiusY="5"/>
                        </GeometryDrawing.Geometry>
                    </GeometryDrawing>
                </DrawingGroup>
            </DrawingImage.Drawing>
        </DrawingImage>
        <SolidColorBrush x:Key="Ink" Color="#172033"/>
        <SolidColorBrush x:Key="Muted" Color="#667085"/>
        <SolidColorBrush x:Key="Line" Color="#E4E7EC"/>
        <SolidColorBrush x:Key="Primary" Color="#635BFF"/>
        <SolidColorBrush x:Key="Surface" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="Glass" Color="#EFFFFFFF"/>
        <SolidColorBrush x:Key="GlassStrong" Color="#F7FFFFFF"/>
        <SolidColorBrush x:Key="GlassLine" Color="#B8FFFFFF"/>
        <DropShadowEffect x:Key="CardShadow" BlurRadius="28" ShadowDepth="8" Direction="270"
                          Color="#52242A56" Opacity="0.18"/>
        <DropShadowEffect x:Key="SmallShadow" BlurRadius="14" ShadowDepth="3" Direction="270"
                          Color="#40242A56" Opacity="0.16"/>
        <Style TargetType="Button">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="16,10"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="#F7FFFFFF"/>
            <Setter Property="Foreground" Value="#172033"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="BorderBrush" Value="#D0D5DD"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="11,9"/>
        </Style>
        <Style TargetType="PasswordBox">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="BorderBrush" Value="#D0D5DD"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="11,9"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="BorderBrush" Value="#D0D5DD"/>
            <Setter Property="Padding" Value="9,7"/>
        </Style>
    </Application.Resources>
</Application>
