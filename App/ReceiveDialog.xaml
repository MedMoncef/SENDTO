<Window x:Class="DropRoom.ReceiveDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Grab from DropRoom" Width="560" Height="620" MinHeight="480"
        WindowStartupLocation="CenterScreen" ResizeMode="CanResize"
        ShowInTaskbar="True" Background="#F5F7FB">
    <Grid Margin="24">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel Orientation="Horizontal" Margin="0,0,0,18">
            <Image Width="42" Height="42" Margin="0,0,12,0"
                   Source="{DynamicResource DropRoomLogo}"/>
            <StackPanel>
                <TextBlock Text="Grab from DropRoom" FontSize="24" FontWeight="SemiBold" Foreground="#101828"/>
                <TextBlock Text="Choose a shared file and save it here." Foreground="#667085"/>
            </StackPanel>
        </StackPanel>
        <DockPanel Grid.Row="1" Margin="0,0,0,14">
            <TextBox x:Name="SearchBox" TextChanged="SearchBox_TextChanged" ToolTip="Filter shared files"/>
            <Button DockPanel.Dock="Right" Content="Refresh" Margin="10,0,0,0" Click="Refresh_Click"/>
        </DockPanel>
        <ListView Grid.Row="2" x:Name="TransfersList" BorderThickness="0" Background="Transparent"
                  SelectionChanged="TransfersList_SelectionChanged">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Border Background="White" BorderBrush="#E4E7EC" BorderThickness="1" CornerRadius="12"
                            Padding="14" Margin="0,0,0,9">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="{Binding Metadata.FileName}" FontWeight="SemiBold" Foreground="#172033"/>
                                <TextBlock Text="{Binding Metadata.Note}" Foreground="#667085" Margin="0,4,0,0"
                                           TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                            <TextBlock Grid.Column="1" Text="{Binding SizeText}" Foreground="#667085" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
        <Grid Grid.Row="3" Margin="0,12,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock x:Name="StatusText" Foreground="#667085"/>
                <ProgressBar x:Name="DownloadProgress" Height="6" Margin="0,8,12,0"
                             Visibility="Collapsed" Minimum="0" Maximum="100"/>
            </StackPanel>
            <Button x:Name="CancelDownloadButton" Grid.Column="1" Content="Cancel download"
                    Visibility="Collapsed" Margin="10,0,0,0" Click="CancelDownload_Click"/>
        </Grid>
    </Grid>
</Window>
