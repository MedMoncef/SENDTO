<Window x:Class="DropRoom.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Settings" Width="560" Height="500" WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize" Background="#F5F7FB">
    <Grid Margin="28">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,20">
            <TextBlock Text="Room settings" FontSize="26" FontWeight="SemiBold" Foreground="#101828"/>
            <TextBlock Text="Your room key is the shared secret. Keep it private." Margin="0,5,0,0" Foreground="#667085"/>
        </StackPanel>
        <StackPanel Grid.Row="1">
            <TextBlock Text="Display name" FontWeight="SemiBold"/>
            <TextBox x:Name="DisplayNameBox" Margin="0,7,0,16" Padding="11,8"/>
            <TextBlock Text="Room key" FontWeight="SemiBold"/>
            <TextBox x:Name="RoomKeyBox" Margin="0,7,0,8" Padding="11,8" IsReadOnly="True"/>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,18">
                <Button Content="Create new room" Click="CreateRoom_Click"/>
                <Button Content="Join with key…" Click="JoinRoom_Click"/>
                <Button Content="Rotate key" Click="Rotate_Click"/>
            </StackPanel>
            <TextBlock Text="Default save folder" FontWeight="SemiBold"/>
            <DockPanel Margin="0,7,0,0">
                <Button DockPanel.Dock="Right" Content="Browse…" Click="Browse_Click"/>
                <TextBox x:Name="SaveFolderBox" Padding="11,8"/>
            </DockPanel>
            <TextBlock Text="Default expiry (hours)" FontWeight="SemiBold" Margin="0,16,0,0"/>
            <TextBox x:Name="ExpiryBox" Text="1" Margin="0,7,0,0" Padding="11,8"/>
        </StackPanel>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Cancel" Click="Cancel_Click"/>
            <Button Content="Save settings" Background="#635BFF" Foreground="White" Click="Save_Click"/>
        </StackPanel>
    </Grid>
</Window>
