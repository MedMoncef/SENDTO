<Window x:Class="DropRoom.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Settings" Width="600" Height="760" MinHeight="560" WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize" Background="#EEF1FF">
    <Window.Resources>
        <Style TargetType="TabControl">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
        </Style>
        <Style TargetType="TabItem">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="18,10"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="Foreground" Value="#667085"/>
            <Setter Property="Background" Value="#22FFFFFF"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="TabBorder" Background="{TemplateBinding Background}"
                                CornerRadius="10,10,0,0" Padding="{TemplateBinding Padding}">
                            <ContentPresenter ContentSource="Header"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="TabBorder" Property="Background" Value="#635BFF"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="TabBorder" Property="Background" Value="#405F5BFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#BFFFFFFF"/>
            <Setter Property="BorderBrush" Value="#CCD2E2"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="13,10"/>
        </Style>
    </Window.Resources>
    <Grid Margin="32">
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#F7F8FF" Offset="0"/>
                <GradientStop Color="#E8E7FF" Offset="0.52"/>
                <GradientStop Color="#F8F3FF" Offset="1"/>
            </LinearGradientBrush>
        </Grid.Background>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,22">
            <StackPanel Orientation="Horizontal">
                <Image Width="46" Height="46" Margin="0,0,13,0"
                       Source="{DynamicResource DropRoomLogo}"/>
                <StackPanel>
                    <TextBlock Text="Room settings" FontSize="28" FontWeight="SemiBold" Foreground="#101828"/>
                    <TextBlock Text="Control your identity, storage, and delivery preferences."
                               Margin="0,4,0,0" Foreground="#667085"/>
                </StackPanel>
            </StackPanel>
        </StackPanel>
        <TabControl Grid.Row="1" Margin="0,0,0,20">
            <TabItem Header="General">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="0,16,10,20">
                        <Border Background="#BFFFFFFF" BorderBrush="#B8FFFFFF" BorderThickness="1"
                                CornerRadius="18" Padding="20" Margin="0,0,0,14">
                            <StackPanel>
                                <TextBlock Text="PROFILE" FontSize="11" FontWeight="Bold"
                                           Foreground="#635BFF"/>
                                <TextBlock Text="How other people identify you in the room."
                                           Foreground="#667085" Margin="0,4,0,14"/>
                                <TextBlock Text="Display name" FontWeight="SemiBold"/>
                                <TextBox x:Name="DisplayNameBox" Margin="0,7,0,0"/>
                            </StackPanel>
                        </Border>
                        <Border Background="#BFFFFFFF" BorderBrush="#B8FFFFFF" BorderThickness="1"
                                CornerRadius="18" Padding="20" Margin="0,0,0,14">
                            <StackPanel>
                                <TextBlock Text="ROOM IDENTITY" FontSize="11" FontWeight="Bold"
                                           Foreground="#635BFF"/>
                                <TextBlock Text="Everyone in the same room uses this shared key."
                                           Foreground="#667085" Margin="0,4,0,14"/>
                                <TextBlock Text="Room key" FontWeight="SemiBold"/>
                                <TextBox x:Name="RoomKeyBox" Margin="0,7,0,12" IsReadOnly="True"/>
                                <WrapPanel>
                                    <Button Content="Create new room" Click="CreateRoom_Click"/>
                                    <Button Content="Join with key…" Click="JoinRoom_Click"/>
                                    <Button Content="Rotate key" Click="Rotate_Click"/>
                                </WrapPanel>
                            </StackPanel>
                        </Border>
                        <Border Background="#BFFFFFFF" BorderBrush="#B8FFFFFF" BorderThickness="1"
                                CornerRadius="18" Padding="20" Margin="0,0,0,14">
                            <StackPanel>
                                <TextBlock Text="STORAGE" FontSize="11" FontWeight="Bold"
                                           Foreground="#635BFF"/>
                                <TextBlock Text="Choose where received files are saved by default."
                                           Foreground="#667085" Margin="0,4,0,14"/>
                                <TextBlock Text="Default save folder" FontWeight="SemiBold"/>
                                <DockPanel Margin="0,7,0,0">
                                    <Button DockPanel.Dock="Right" Content="Browse…" Click="Browse_Click"/>
                                    <TextBox x:Name="SaveFolderBox"/>
                                </DockPanel>
                                <TextBlock Text="Default expiry (hours)" FontWeight="SemiBold" Margin="0,18,0,0"/>
                                <TextBox x:Name="ExpiryBox" Text="1" Margin="0,7,0,0"/>
                            </StackPanel>
                        </Border>
                        <Border Background="#BFFFFFFF" BorderBrush="#B8FFFFFF" BorderThickness="1"
                                CornerRadius="18" Padding="20">
                            <StackPanel>
                                <TextBlock Text="DELIVERY MODE" FontSize="11" FontWeight="Bold"
                                           Foreground="#635BFF"/>
                                <TextBlock Text="Choose how new transfers leave this device."
                                           Foreground="#667085" Margin="0,4,0,14"/>
                                <ComboBox x:Name="TransportBox">
                                    <ComboBoxItem Content="Office sharing"/>
                                    <ComboBoxItem Content="Public send"/>
                                </ComboBox>
                                <TextBlock Text="Office sharing keeps the encrypted file available from the sender’s office device until it expires."
                                           Foreground="#667085" TextWrapping="Wrap" Margin="0,10,0,0"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="Public send">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="0,16,10,20">
                        <Border Background="#BFFFFFFF" BorderBrush="#B8FFFFFF" BorderThickness="1"
                                CornerRadius="18" Padding="22">
                            <StackPanel>
                                <TextBlock Text="PUBLIC SEND" FontSize="11" FontWeight="Bold"
                                           Foreground="#635BFF"/>
                                <TextBlock Text="Connect DropRoom to an internet-accessible transfer backend."
                                           FontSize="20" FontWeight="SemiBold" Foreground="#172033"
                                           Margin="0,5,0,4"/>
                                <TextBlock Text="The desktop app stores only the endpoint. Database, object storage, authentication, quotas, and rate limits stay on your server."
                                           Foreground="#667085" TextWrapping="Wrap" Margin="0,0,0,20"/>
                                <TextBlock Text="Backend URL" FontWeight="SemiBold"/>
                                <TextBox x:Name="BackendUrlBox" Margin="0,7,0,16"
                                         ToolTip="The URL of your deployed Worker/API, not database credentials."/>
                                <Border Background="#EEF0FF" CornerRadius="14" Padding="16">
                                    <StackPanel>
                                        <TextBlock Text="Before enabling Public send" FontWeight="SemiBold"
                                                   Foreground="#423B9A"/>
                                        <TextBlock Text="Deploy a compatible backend first. This project includes the typed client, but does not include a hosted database or storage service."
                                                   Foreground="#5A55A8" TextWrapping="Wrap" Margin="0,5,0,0"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>
        <Border Grid.Row="2" BorderBrush="#E4E7EC" BorderThickness="0,1,0,0" Padding="0,18,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Cancel" Click="Cancel_Click"/>
                <Button Content="Save settings" Background="#635BFF" Foreground="White" Margin="0" Click="Save_Click"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
