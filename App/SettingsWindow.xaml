<Window x:Class="DropRoom.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Settings" Width="600" Height="760" MinHeight="560" WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize" Background="#F5F7FB">
    <Grid Margin="32">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,22">
            <StackPanel Orientation="Horizontal">
                <Border Width="42" Height="42" CornerRadius="13" Background="#090B14" Margin="0,0,12,0"
                        Padding="2">
                    <Border CornerRadius="10" Background="#635BFF">
                        <TextBlock Text="D" Foreground="White" FontSize="22" FontWeight="Bold"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   TextAlignment="Center"/>
                    </Border>
                </Border>
                <StackPanel>
                    <TextBlock Text="Room settings" FontSize="26" FontWeight="SemiBold" Foreground="#101828"/>
                    <TextBlock Text="Personalize how DropRoom shares files." Margin="0,3,0,0" Foreground="#667085"/>
                </StackPanel>
            </StackPanel>
        </StackPanel>
        <TabControl Grid.Row="1" Margin="0,0,0,20">
            <TabItem Header="General">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="0,18,10,20">
                <TextBlock Text="PROFILE" FontSize="11" FontWeight="Bold" Foreground="#635BFF" Margin="0,0,0,8"/>
                <TextBlock Text="Display name" FontWeight="SemiBold"/>
                <TextBox x:Name="DisplayNameBox" Margin="0,7,0,18"/>
                <TextBlock Text="ROOM IDENTITY" FontSize="11" FontWeight="Bold" Foreground="#635BFF" Margin="0,2,0,8"/>
                <TextBlock Text="Room key" FontWeight="SemiBold"/>
                <TextBox x:Name="RoomKeyBox" Margin="0,7,0,8" IsReadOnly="True"/>
                <WrapPanel Margin="0,0,0,22">
                    <Button Content="Create new room" Click="CreateRoom_Click"/>
                    <Button Content="Join with key…" Click="JoinRoom_Click"/>
                    <Button Content="Rotate key" Click="Rotate_Click"/>
                </WrapPanel>
                <TextBlock Text="STORAGE" FontSize="11" FontWeight="Bold" Foreground="#635BFF" Margin="0,0,0,8"/>
                <TextBlock Text="Default save folder" FontWeight="SemiBold"/>
                <DockPanel Margin="0,7,0,0">
                    <Button DockPanel.Dock="Right" Content="Browse…" Click="Browse_Click"/>
                    <TextBox x:Name="SaveFolderBox"/>
                </DockPanel>
                <TextBlock Text="Default expiry (hours)" FontWeight="SemiBold" Margin="0,18,0,0"/>
                <TextBox x:Name="ExpiryBox" Text="1" Margin="0,7,0,22"/>
                <TextBlock Text="DELIVERY MODE" FontSize="11" FontWeight="Bold" Foreground="#635BFF" Margin="0,0,0,8"/>
                <TextBlock Text="Default sending method" FontWeight="SemiBold"/>
                <ComboBox x:Name="TransportBox" Margin="0,7,0,0">
                    <ComboBoxItem Content="Office sharing"/>
                    <ComboBoxItem Content="Public send"/>
                </ComboBox>
                        <TextBlock Text="Office sharing keeps the encrypted file available from the sender’s office device until it expires."
                                   Foreground="#667085" TextWrapping="Wrap" Margin="0,8,0,8"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="Public send">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="0,18,10,20">
                        <TextBlock Text="PUBLIC BACKEND" FontSize="11" FontWeight="Bold"
                                   Foreground="#635BFF" Margin="0,0,0,8"/>
                        <TextBlock Text="Backend URL" FontWeight="SemiBold"/>
                        <TextBox x:Name="BackendUrlBox" Margin="0,7,0,0"
                                 ToolTip="The URL of your deployed Worker/API, not database credentials."/>
                        <TextBlock Text="Public send is intended for transfers through an external internet backend. Database, object storage, authentication, quotas, and rate limits belong on that backend."
                                   Foreground="#667085" TextWrapping="Wrap" Margin="0,8,0,16"/>
                        <Border Background="#EEF0FF" CornerRadius="12" Padding="14">
                            <TextBlock Text="Only use Public send after a compatible backend has been deployed. The current project includes the typed client, but not a hosted database or storage service."
                                       Foreground="#423B9A" TextWrapping="Wrap"/>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>
        <Border Grid.Row="2" BorderBrush="#E4E7EC" BorderThickness="0,1,0,0" Padding="0,18,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Cancel" Click="Cancel_Click"/>
                <Button Content="Save settings" Background="#635BFF" Foreground="White" Margin="0" Click="Save_Click"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
