<Window x:Class="DropRoom.SendDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Send to room" Width="580" Height="700" MinHeight="560" WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize" Background="#F5F7FB">
    <Window.Resources>
        <Style TargetType="TextBox"><Setter Property="Padding" Value="11,8"/><Setter Property="BorderBrush" Value="#D0D5DD"/></Style>
        <Style TargetType="ComboBox"><Setter Property="Padding" Value="9,7"/></Style>
        <Style TargetType="Button"><Setter Property="Padding" Value="16,10"/><Setter Property="Margin" Value="0,0,8,0"/></Style>
    </Window.Resources>
    <Grid Margin="28">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,20">
            <StackPanel Orientation="Horizontal">
                <Border Width="42" Height="42" CornerRadius="13" Background="#090B14" Margin="0,0,12,0"
                        Padding="2">
                    <Border CornerRadius="10" Background="#635BFF">
                        <TextBlock Text="D" Foreground="White" FontSize="22" FontWeight="Bold"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   TextAlignment="Center"/>
                    </Border>
                </Border>
                <StackPanel>
                    <TextBlock Text="Send to room" FontSize="26" FontWeight="SemiBold" Foreground="#101828"/>
                    <TextBlock x:Name="FileSummary" Margin="0,3,0,0" Foreground="#667085"/>
                </StackPanel>
            </StackPanel>
        </StackPanel>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="0,0,10,18">
            <TextBlock Text="Display name" FontWeight="SemiBold"/>
            <TextBox x:Name="NameBox" Margin="0,7,0,15"/>
            <TextBlock Text="Note for recipients" FontWeight="SemiBold"/>
            <TextBox x:Name="NoteBox" Margin="0,7,0,15" Height="72" AcceptsReturn="True" TextWrapping="Wrap"/>
            <TextBlock Text="PIN (4–6 digits)" FontWeight="SemiBold"/>
            <Grid Margin="0,7,0,15">
                <PasswordBox x:Name="PinBox" Padding="11,9" MaxLength="6"
                             PreviewTextInput="PinBox_PreviewTextInput"
                             DataObject.Pasting="PinBox_Pasting"/>
                <TextBox x:Name="VisiblePinBox" Padding="11,9" MaxLength="6"
                         Visibility="Collapsed"
                         PreviewTextInput="PinBox_PreviewTextInput"
                         DataObject.Pasting="PinBox_Pasting"
                         TextChanged="VisiblePinBox_TextChanged"/>
                <Button x:Name="ShowPinButton" Content="◉" Width="34" Height="30"
                        HorizontalAlignment="Right" Margin="0,0,5,0"
                        Padding="0" Background="Transparent" Foreground="#667085"
                        ToolTip="Show PIN" Click="ShowPin_Click"/>
            </Grid>
            <TextBlock Text="Recipients" FontWeight="SemiBold"/>
            <TextBox x:Name="RecipientCountBox" Text="1" Margin="0,7,0,15"/>
            <TextBlock Text="Visibility" FontWeight="SemiBold"/>
            <StackPanel Margin="0,8,0,15">
                <RadioButton x:Name="OfficeOnlyRadio" Content="Office only" IsChecked="True"
                             GroupName="Visibility" Margin="0,0,0,8"/>
                <RadioButton x:Name="AnyoneRadio" Content="Anyone in the room"
                             GroupName="Visibility"/>
            </StackPanel>
            <TextBlock Text="The file is encrypted before it leaves this device."
                       Foreground="#667085" TextWrapping="Wrap"/>
        </StackPanel>
        </ScrollViewer>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Cancel" Click="Cancel_Click"/>
            <Button Content="Send securely" Background="#635BFF" Foreground="White" Click="Send_Click"/>
        </StackPanel>
    </Grid>
</Window>
